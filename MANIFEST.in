include LICENSE README.md SKILL.md CHANGELOG.md CONTRIBUTING.md SECURITY.md THIRD_PARTY_NOTICES.md
include .gitignore .gitattributes
include config/config.example.yaml
include agents/openai.yaml
recursive-include references *.md
include scripts/README.md scripts/run.py scripts/setup.py scripts/audit_release.py scripts/benchmark_slides.py
recursive-include docs *.md
recursive-include tests *.py
global-exclude *.py[cod]
prune notes
prune .venv
